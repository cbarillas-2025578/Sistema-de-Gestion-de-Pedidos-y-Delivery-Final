# =====================================================================
# Variables de entorno de ejemplo (copiar a .env y ajustar valores)
# NUNCA versione un archivo .env real con credenciales.
# =====================================================================

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SistemaGestionPedidos
DB_USERNAME=postgres
DB_PASSWORD=admin

# --- JWT (obligatorio, mínimo 32 caracteres) ---
# Generar con: openssl rand -base64 48
JWT_SECRET=cambie-esta-clave-por-una-clave-secreta-larga-y-aleatoria-de-al-menos-32-caracteres
# Duración del token (por defecto 24 h)
JWT_EXPIRATION_MS=86400000

# --- CORS: orígenes permitidos, separados por comas ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Inicialización segura del primer administrador ---
# Credenciales que usa test-api1.sh (en producción use valores propios)
ADMIN_EMAIL=admin@fastorder.com
ADMIN_PASSWORD=Admin123*

# --- Servidor ---
SERVER_PORT=8080
